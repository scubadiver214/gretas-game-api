# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public host name pointing at the VPS (A/AAAA record). Caddy fetches a TLS cert for it.
DOMAIN=play.example.com
# Optional: Let's Encrypt account e-mail.
ACME_EMAIL=

# Postgres superuser password; generate one, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# Optional: deploy prebuilt images instead of building on the VPS.
# WEB_IMAGE=ghcr.io/<owner>/gretas-game-web:latest
# API_IMAGE=ghcr.io/<owner>/gretas-game-api:latest
# MIGRATIONS_IMAGE=ghcr.io/<owner>/gretas-game-migrations:latest
